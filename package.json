{
  "name": "mcpj-meta-ads",
  "version": "0.0.5",
  "description": "Meta (Facebook) Ads MCP server — manage campaigns, ad sets, ads, creatives, audiences & insights via natural language",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcpj-meta-ads": "dist/index.js"
  },
  "files": [
    "dist",
    "logo.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun src/index.ts",
    "build": "bun build src/index.ts --compile --outfile=mcp-meta-ads",
    "build:npm": "bun build src/index.ts --bundle --target node --outfile dist/index.js && node -e \"const f='dist/index.js';require('fs').writeFileSync(f,require('fs').readFileSync(f,'utf8').replace('#!/usr/bin/env bun','#!/usr/bin/env node'))\"",
    "prepublishOnly": "bun run build:npm",
    "test": "bun test",
    "test:live": "META_ADS_RUN_LIVE_TESTS=true bun test tests/live",
    "test:create-account": "bun scripts/create-test-account.ts",
    "test:cleanup": "bun scripts/cleanup-test-entities.ts",
    "test:cleanup:dry": "bun scripts/cleanup-test-entities.ts --dry-run",
    "typecheck": "tsc --noEmit",
    "inspect": "bunx @modelcontextprotocol/inspector bun src/index.ts",
    "format": "biome format --write .",
    "lint": "biome check .",
    "check": "biome check --write ."
  },
  "keywords": [
    "mcp",
    "meta-ads",
    "facebook-ads",
    "instagram-ads",
    "marketing-api",
    "ai",
    "claude",
    "model-context-protocol",
    "bun"
  ],
  "author": "pijusz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pijusz/mcp-meta-ads.git"
  },
  "engines": {
    "node": ">=18"
  },
  "homepage": "https://github.com/pijusz/mcp-meta-ads#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/bun": "1.4.3",
    "typescript": "7.0.2"
  },
  "mcpName": "io.github.pijusz/mcpj-meta-ads"
}
