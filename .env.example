# Meta Marketing API access — System User token from Business Manager
META_ADS_ACCESS_TOKEN=your-system-user-token

# Optional: Meta App ID (required only for scripts/create-test-account.ts)
# META_ADS_APP_ID=your-app-id

# Optional: app secret for appsecret_proof (recommended for production)
# META_ADS_APP_SECRET=your-app-secret

# Optional: live integration tests (disabled unless META_ADS_RUN_LIVE_TESTS=true)
# META_ADS_RUN_LIVE_TESTS=true
# META_ADS_TEST_ACCOUNT_ID=act_xxxxxxxxxxxx
# META_ADS_TEST_BUSINESS_ATTACHED=true

# Optional: CAPI live tests (POST permanent events; use a dedicated test pixel)
# META_ADS_TEST_PIXEL_ID=xxxxxxxxxxxx
# META_ADS_TEST_EVENT_CODE=TEST12345
# META_ADS_ALLOW_CAPI_EVENT_WRITES=true

# Optional: Graph API version override (default: v26.0 — current stable as of 2026-10)
# META_GRAPH_API_VERSION=v26.0

# Optional: validate token at startup with GET /me probe
# META_ADS_VALIDATE_AT_STARTUP=true

# Optional: rate-limit awareness — proactive backoff threshold (% usage)
# META_ADS_RATE_LIMIT_THRESHOLD=75

# Optional: default page size for paginated reads (default: 25)
# META_ADS_DEFAULT_PAGE_SIZE=25

# Optional: async insights timeout in ms (default: 120000 = 2 minutes)
# META_ADS_INSIGHTS_ASYNC_TIMEOUT_MS=120000

# Optional: base poll interval for async insights in ms (default: 2000)
# META_ADS_INSIGHTS_ASYNC_POLL_MS=2000

# Optional: log level — error | warn | info | debug (default: warn)
# META_ADS_LOG_LEVEL=warn
